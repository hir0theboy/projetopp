{
  "name": "Calor 2D - Programacao Paralela",
  "build": { "dockerfile": "../Dockerfile", "context": ".." },
  "remoteUser": "dev",
  "runArgs": ["--shm-size=1g", "--cap-add=SYS_PTRACE", "--security-opt", "seccomp=unconfined"],
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.makefile-tools",
        "ms-python.python"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "files.eol": "\n",
        "editor.formatOnSave": false
      }
    }
  },
  "postCreateCommand": "g++ --version | head -1 && mpirun --version | head -1 && nproc"
}
